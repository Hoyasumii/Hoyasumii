# Read at build time: the pages are rendered from what the API returns.
# Leave empty to build with the default content (useful for a first look).
API_URL=http://localhost:8787

# Used by the admin panel in the browser.
NEXT_PUBLIC_API_URL=http://localhost:8787
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Public address, for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://hoyasumii.dev
# Only when Pages serves the site from a sub-path (no custom domain).
NEXT_PUBLIC_BASE_PATH=
