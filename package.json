{
	"name": "portfolio",
	"private": true,
	"type": "module",
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dev:web": "bun --filter @portfolio/web dev",
		"dev:api": "bun --filter @portfolio/api dev",
		"build:web": "bun --filter @portfolio/web build",
		"test": "bun --filter '*' test",
		"typecheck": "bun --filter '*' typecheck",
		"lint": "biome check .",
		"format": "biome check --write ."
	},
	"packageManager": "bun@1.4.2",
	"devDependencies": {
		"@biomejs/biome": "^2.6.2",
		"typescript": "^7.0.2"
	}
}
